#!/bin/bash
# Generate site for linecircle benchmark

. common

cd "$exp" || exit 1

echo "Updating site data.js..."
cat << 'EOF' > update_data.py
import os
import subprocess
import json
import math

plot_data = []

dirs = sorted([d for d in os.listdir('.') if d.startswith('licir-P')], key=lambda x: int(x.split('-P')[1]))

for d in dirs:
    config_name = d.split('-')[1]
    config_id = int(config_name.replace('P', ''))
    step_file = os.path.join(d, f"sol_step-{config_name}.txt")
    cfg_file = os.path.join(d, f"configANDgt-{config_name}.txt")
    
    steps = []
    if os.path.exists(step_file):
        with open(step_file, 'r') as sf:
            steps = [int(line.strip()) for line in sf if line.strip().isdigit()]

    config_str = "No config found"
    circle_data = {"a": 1, "b": 0, "c": 0, "xc": 0, "yc": 0, "r": 1}
    line_data = {"d": 0, "e": 1, "f": 0}
    pts_data = []

    # Check if ground-truth was found (gt* file: 1 = found, 0 = failed)
    gt_val = 1
    gt_files = [f for f in os.listdir(d) if f.startswith('gt')]
    if gt_files:
        try:
            with open(os.path.join(d, gt_files[0]), 'r') as gf:
                content = gf.read().strip()
                if content.isdigit():
                    gt_val = int(content)
        except Exception as e:
            pass

    if os.path.exists(cfg_file):
        with open(cfg_file, 'r') as cf:
            config_str = cf.read().strip()
        parts = config_str.split()
        if len(parts) >= 20:
            try:
                # Format: cir1 0 cir2 0 cir3 0 li1 0 li2 0 li3 0 pt1x 0 pt1y 0 pt2x 0 pt2y 0
                cir1 = float(parts[0])
                cir2 = float(parts[2])
                cir3 = float(parts[4])
                li1 = float(parts[6])
                li2 = float(parts[8])
                li3 = float(parts[10])
                pt1x = float(parts[12])
                pt1y = float(parts[14])
                pt2x = float(parts[16])
                pt2y = float(parts[18])

                xc = -cir2 / (2.0 * cir1) if cir1 != 0 else 0.0
                yc = 0.0
                r2 = (cir2 / (2.0 * cir1))**2 - (cir3 / cir1) if cir1 != 0 else 0.0
                r = math.sqrt(r2) if r2 > 0 else 0.0

                circle_data = {
                    "a": cir1, "b": cir2, "c": cir3,
                    "xc": xc, "yc": yc, "r": r
                }
                line_data = {
                    "d": li1, "e": li2, "f": li3
                }
                pts_data = [
                    {"x": pt1x, "y": pt1y},
                    {"x": pt2x, "y": pt2y}
                ]
            except Exception as e:
                print(f"Error parsing geometry for {config_name}: {e}")

    plot_data.append({
        "x": config_name,
        "y": steps,
        "gt": gt_val,
        "config": config_str,
        "circle": circle_data,
        "line": line_data,
        "points": pts_data
    })

grand_median = 0
if os.path.exists("all_steps.txt"):
    with open("all_steps.txt") as af:
        steps_all = [int(l.strip()) for l in af if l.strip().isdigit()]
    steps_all.sort()
    if steps_all:
        mid = len(steps_all) // 2
        grand_median = steps_all[mid] if len(steps_all) % 2 == 1 else (steps_all[mid - 1] + steps_all[mid]) / 2.0

with open("data.js", "w") as f:
    f.write(f"const benchmarkData = {json.dumps(plot_data)};\n")
    f.write(f"const grandMedian = {grand_median};\n")
    f.write(f"const numRuns = 1;\n")
EOF

python3 update_data.py

cat << 'EOF' > index.html

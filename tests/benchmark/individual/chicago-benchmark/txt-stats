#!/bin/bash

# Generate Version 2.0.1 Summaries
. common

set +x

cd "$exp" || exit 1

cat frpt-P*/sol_step-P*.txt > all_steps.txt 2>/dev/null

generate_stats() {
    is_color=$1
    if [ "$is_color" == "color" ]; then
        C_RESET="\033[0m"
        C_TITLE="\033[1;37m"
        C_ID="\033[1;36m"
        C_SUM="\033[1;33m"
        C_MED="\033[1;32m"
    else
        C_RESET=""
        C_TITLE=""
        C_ID=""
        C_SUM=""
        C_MED=""
    fi

    printf "%b\n" "${C_TITLE}MINUS Benchmark Results Summary${C_RESET}"
    echo "-------------------------------"
    echo ""
    printf "%b\n" "${C_TITLE}Per Configuration:${C_RESET}"

    grand_sum=0
    # sort numerically by config id
    dirs=$(ls -d frpt-P*/ 2>/dev/null | awk -F'[-/]' '{print $2}' | sed 's/P//' | sort -n)

    for id in $dirs; do
        step_file="frpt-P${id}/sol_step-P${id}.txt"
        if [ -f "$step_file" ]; then
            s=$(st --sum --no-header "$step_file" | awk '{print $1}')
            m=$(st --median --no-header "$step_file" | awk '{print $1}')
            
            printf "%b\n" "  Config ${C_ID}P${id}${C_RESET} Steps: Sum = ${C_SUM}${s}${C_RESET}, Median = ${C_MED}${m}${C_RESET}"
            grand_sum=$(echo "$grand_sum + $s" | bc)
        fi
    done

    grand_median=$(st --median --no-header all_steps.txt | awk '{print $1}')

    echo ""
    printf "%b\n" "${C_TITLE}Grand Totals:${C_RESET}"
    printf "%b\n" "  Total Iteration Steps: ${C_SUM}${grand_sum}${C_RESET}"
    printf "%b\n" "  Grand Median Steps: ${C_MED}${grand_median}${C_RESET}"
}

echo "Generating txt statistics..."
generate_stats plain > summary.txt
generate_stats color

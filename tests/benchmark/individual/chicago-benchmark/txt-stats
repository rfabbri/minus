#!/bin/bash

# Generate Version 2.0.1 Summaries
. common

set +x

cd "$exp" || exit 1

cat frpt-P*/sol_step-P*.txt > all_steps.txt 2>/dev/null

generate_stats() {
    is_color=$1
    if [ "$is_color" == "color" ]; then
        C_RESET="\033[0m"
        C_TITLE="\033[1;37m"
        C_ID="\033[1;36m"
        C_SUM="\033[1;33m"
        C_MED="\033[1;32m"
    else
        C_RESET=""
        C_TITLE=""
        C_ID=""
        C_SUM=""
        C_MED=""
    fi

    printf "%b\n" "${C_TITLE}MINUS Chicago Benchmark Results Summary${C_RESET}"
    echo "-------------------------------"
    echo
    printf "%b\n" "${C_TITLE}Per Configuration:${C_RESET}"

    # sort numerically by config id
    dirs=$(ls -d frpt-P*/ 2>/dev/null | awk -F'[-/]' '{print $2}' | sed 's/P//' | sort -n)

    for id in $dirs; do
        config_dir="frpt-P${id}"
        step_file="$config_dir/sol_step-P${id}.txt"
        if [ -f "$step_file" ]; then
          read -r s m <<< $(sort -n "$step_file" | awk 'BEGIN{CONVFMT="%.0f"; OFMT="%.0f"} {sum+=$1; vals[NR]=$1} END {n=NR; if (n==0) {print 0, 0} else if (n%2==1) {printf "%.0f %g\n", sum, vals[(n+1)/2]} else {printf "%.0f %g\n", sum, (vals[n/2]+vals[n/2+1])/2}}')
            
          nsuccesses=$(grep -v 313 $config_dir/gt_sol*|wc -l|xargs echo)
          printf "%b\n" "  Config ${C_ID}P${id}${C_RESET} Steps: Sum = ${C_SUM}${s}${C_RESET}, Median = ${C_MED}${m}${C_RESET}, Successes = $nsuccesses/$nruns_per_config ($(echo "scale=1; 100.0*$nsuccesses/$nruns_per_config"|bc)%)"
        fi
    done

    grand_sum=$(awk 'BEGIN{CONVFMT="%.0f"; OFMT="%.0f"} {sum += $1} END {printf "%.0f\n", sum}' all_steps.txt)
    grand_median=$(sort -n all_steps.txt | awk '{vals[NR]=$1} END {n=NR; if (n==0) print 0; else if (n%2==1) print vals[(n+1)/2]; else print (vals[n/2]+vals[n/2+1])/2}')
    grand_failures=$(grep 313 frpt-P*/gt_sol*|wc -l)
    grand_nruns=`echo $nconfigs*$nruns_per_config|bc`
    grand_success=`echo "scale=1; 100.0*($grand_nruns - $grand_failures)/$grand_nruns"|bc`

    echo
    printf "%b\n" "${C_TITLE}Grand Totals:${C_RESET}"
    printf "%b\n" "  Total Iteration Steps: ${C_SUM}${grand_sum}${C_RESET}"
    printf "%b\n" "  Grand Median Steps: ${C_MED}${grand_median}${C_RESET}"
    printf "%b\n" "  Grand Median Steps: ${C_MED}${grand_median}${C_RESET}"
    printf "%b\n" "  Grand Successs Rate / ground-truth found within all runs & all configs: ${C_MED}${grand_success}${C_RESET}%"
}

echo "Generating txt statistics..."
generate_stats plain > summary.txt
generate_stats color

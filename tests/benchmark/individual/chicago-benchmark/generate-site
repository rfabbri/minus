#!/bin/sh
# see ./main script

. common

cd "$exp" || exit 1

echo "Updating site data.js..."
cat << 'EOF' > update_data.py
import os
import subprocess
import json

plot_data = []

synthdata_bin = os.environ.get("SYNTHDATA_BIN", "/Users/rfabbri/cprg/vxlprg/lemsvpe/minus/scripts/synthdata/synthdata")

try:
    with open("../../inputs/configuration-spec/FRePTcorrigido.txt", "r") as frept_f:
        frept_lines = [line.strip() for line in frept_f.readlines()]
except Exception:
    try:
        with open("../inputs/configuration-spec/FRePTcorrigido.txt", "r") as frept_f:
            frept_lines = [line.strip() for line in frept_f.readlines()]
    except Exception:
        frept_lines = []

dirs = sorted([d for d in os.listdir('.') if d.startswith('frpt-P')], key=lambda x: int(x.split('-P')[1]))

for d in dirs:
    config_name = d.split('-')[1]
    config_id = int(config_name.replace('P', ''))
    step_file = os.path.join(d, f"sol_step-{config_name}.txt")
    
    if os.path.exists(step_file):
        with open(step_file, 'r') as sf:
            steps = [int(line.strip()) for line in sf if line.strip().isdigit()]
        
        config_str = "No config found"
        point_data = {"f1": [], "f2": [], "f3": []}
        
        if 0 < config_id <= len(frept_lines):
            config_str = frept_lines[config_id - 1]
            try:
                # Call synthdata to get points
                args = config_str.split()
                # Run synthdata
                res = subprocess.check_output([synthdata_bin] + args, stderr=subprocess.STDOUT).decode('utf-8')
                
                # Parse 2D points from output
                current_frame = None
                frame_idx = 0
                frames_keys = ["f1", "f2", "f3"]
                
                for line in res.splitlines():
                    if "LOG(synthdata) 2D points for frame" in line:
                        current_frame = frames_keys[frame_idx]
                        frame_idx += 1
                        continue
                    if current_frame and ("LOG" not in line) and (line.strip() != ""):
                        parts = line.strip().split()
                        if len(parts) >= 2:
                            x, y = float(parts[0]), float(parts[1])
                            point_data[current_frame].append({"x": x, "y": y})
                    if current_frame and ("LOG(synthdata) 2D tangents" in line or "LOG(synthdata) id" in line):
                        current_frame = None

            except Exception as e:
                print(f"Error fetching synthdata for {config_name}: {e}")

        plot_data.append({
            "x": config_name,
            "y": steps,
            "config": config_str,
            "points": point_data
        })

try:
    grand_median = subprocess.check_output(["st", "--median", "--no-header", "all_steps.txt"]).decode().strip()
except Exception:
    grand_median = 0

with open("data.js", "w") as f:
    f.write(f"const benchmarkData = {json.dumps(plot_data)};\n")
    f.write(f"const grandMedian = {grand_median};\n")

EOF

env SYNTHDATA_BIN="$synthdata" python3 update_data.py


if [ ! -f index.html ]; then
  cat << 'EOF' > index.html
<!DOCTYPE html>
<html>
<head>
    <title>MINUS Benchmark Results v2.0</title>
    <script src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>
    <style>
        body { font-family: sans-serif; margin: 20px; background-color: #fafafa; }
        #myDiv { background-color: white; border: 1px solid #ccc; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        #infoPanel { margin-top: 20px; padding: 15px; background: white; border: 1px solid #ccc; display: none; }
        .views-container {
            display: flex;
            gap: 15px;
            margin-top: 15px;
        }
        .view-canvas {
            border: 1px solid #333;
            background-color: #f9f9f9;
            width: 125px; /* ~1.3 inches based on standard DPI, scaled from 500 */
            height: 100px; /* scaled from 400 */
        }
    </style>
</head>
<body>
    <h1>MINUS Benchmark Results (Version 2.0)</h1>
    <div id="myDiv" style="width: 100%; height: 800px;"></div>
    
    <div id="infoPanel">
        <h3>Configuration Details</h3>
        <p><strong>ID:</strong> <span id="configId"></span></p>
        <p><strong>Synthdata:</strong> <span id="configStr"></span></p>
        <div class="views-container">
            <svg class="view-canvas" id="view1" viewBox="0 0 500 400"></svg>
            <svg class="view-canvas" id="view2" viewBox="0 0 500 400"></svg>
            <svg class="view-canvas" id="view3" viewBox="0 0 500 400"></svg>
        </div>
    </div>

    <script src="data.js"></script>
    <script>
        const traces = [];
        
        benchmarkData.forEach(item => {
            traces.push({
                y: item.y,
                name: item.x,
                type: 'box',
                boxpoints: 'outliers',
                jitter: 0,
                pointpos: 0,
                width: 0.2,
                marker: { 
                    color: 'lightgray', 
                    size: 4, 
                    symbol: 'cross' 
                }, 
                line: { 
                    color: 'blue', 
                    width: 1 
                }, 
                fillcolor: 'blue',
                hoverinfo: 'y',
                customdata: [item.config, item.points]
            });
            
            // Calculate median to overlay the white/black dot
            item.y.sort((a,b) => a-b);
            let med;
            let mid = Math.floor(item.y.length / 2);
            if (item.y.length % 2 === 0) {
                med = (item.y[mid - 1] + item.y[mid]) / 2;
            } else {
                med = item.y[mid];
            }
            
            // Overlay median dot trace
            traces.push({
                x: [item.x],
                y: [med],
                mode: 'markers',
                marker: {
                    color: 'white',
                    size: 10,
                    line: {
                        color: 'black',
                        width: 1.5
                    }
                },
                hoverinfo: 'skip',
                showlegend: false
            });
        });

        const layout = {
            title: '<b>Time spent in paths leading to undesired roots</b>',
            titlefont: { size: 24 },
            showlegend: false,
            yaxis: {
                title: 'Number of iterations per root',
                titlefont: { size: 20 },
                zeroline: false,
                range: [0, 1050],
                dtick: 100,
                gridcolor: '#eee'
            },
            xaxis: {
                title: 'Problem',
                titlefont: { size: 20 },
                tickangle: -90,
                tickfont: { size: 10 }
            },
            shapes: [
                // Green horizontal line for grand median
                {
                    type: 'line',
                    xref: 'paper',
                    x0: 0,
                    x1: 1,
                    yref: 'y',
                    y0: grandMedian,
                    y1: grandMedian,
                    line: {
                        color: 'lime',
                        width: 3
                    }
                }
            ],
            annotations: [
                {
                    x: 1,
                    y: grandMedian,
                    xref: 'paper',
                    yref: 'y',
                    text: 'Median time',
                    showarrow: false,
                    xanchor: 'right',
                    yanchor: 'bottom',
                    font: { size: 16 },
                    bgcolor: 'white',
                    bordercolor: 'black'
                }
            ],
            plot_bgcolor: 'white',
            paper_bgcolor: '#fafafa',
            margin: { l: 80, r: 50, b: 80, t: 80 }
        };

        Plotly.newPlot('myDiv', traces, layout, {responsive: true});

        const colors = ['red', 'blue', 'green'];

        function renderPoints(svgId, pts) {
            const svg = document.getElementById(svgId);
            svg.innerHTML = '';
            pts.forEach((p, idx) => {
                const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                circle.setAttribute('cx', p.x);
                circle.setAttribute('cy', p.y);
                circle.setAttribute('r', 6); // 6 units in 500x400 = 1.5px visual radius on 125x100 canvas (3pt thickness)
                const c = colors[idx % colors.length];
                circle.setAttribute('fill', c);
                svg.appendChild(circle);
            });
        }

        // Add Interactivity
        document.getElementById('myDiv').on('plotly_click', function(data){
            if(data.points.length > 0) {
                const pt = data.points[0];
                const configId = pt.data.name;
                const custom = pt.data.customdata;
                const configStr = custom[0];
                const ptsData = custom[1];
                
                const panel = document.getElementById('infoPanel');
                document.getElementById('configId').innerText = configId;
                document.getElementById('configStr').innerText = configStr;
                
                if (ptsData) {
                    renderPoints('view1', ptsData.f1 || []);
                    renderPoints('view2', ptsData.f2 || []);
                    renderPoints('view3', ptsData.f3 || []);
                }
                
                panel.style.display = 'block';
            }
        });
    </script>
</body>
</html>
EOF
fi

echo "Done! See index.html to view interactive charts. data.js has been updated."

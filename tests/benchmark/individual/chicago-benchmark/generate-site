                </tr>
            </thead>
            <tbody>
                <tr>
                    <td rowspan="4" style="padding: 8px; border: 1px solid #ddd; vertical-align: top;"><strong>General specs</strong></td>
                    <td style="padding: 8px; border: 1px solid #ddd;">Number of complex solutions</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">312</td>
                </tr>
                <tr>

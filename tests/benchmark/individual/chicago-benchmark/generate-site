#!/bin/sh
# see ./main script

. common

cd "$exp" || exit 1

echo "Updating site data.js..."
cat << 'EOF' > update_data.py
import os
import subprocess
import json

plot_data = []

synthdata_bin = os.environ.get("SYNTHDATA_BIN", "synthdata")

try:
    with open("../../inputs/configuration-spec/FRePTcorrigido.txt", "r") as frept_f:
        frept_lines = [line.strip() for line in frept_f.readlines()]
except Exception:
    try:
        with open("../inputs/configuration-spec/FRePTcorrigido.txt", "r") as frept_f:
            frept_lines = [line.strip() for line in frept_f.readlines()]
    except Exception:
        frept_lines = []

dirs = sorted([d for d in os.listdir('.') if d.startswith('frpt-P')], key=lambda x: int(x.split('-P')[1]))

for d in dirs:
    config_name = d.split('-')[1]
    config_id = int(config_name.replace('P', ''))
    step_file = os.path.join(d, f"sol_step-{config_name}.txt")
    
    if os.path.exists(step_file):
        with open(step_file, 'r') as sf:
            steps = [int(line.strip()) for line in sf if line.strip().isdigit()]
        
        config_str = "No config found"
        point_data = {"f1": [], "f2": [], "f3": []}
        tangent_data = {"f1": [], "f2": [], "f3": []}
        
        if 0 < config_id <= len(frept_lines):
            config_str = frept_lines[config_id - 1]
            try:
                args = config_str.split()
                res = subprocess.check_output([synthdata_bin] + args, stderr=subprocess.STDOUT).decode('utf-8')
                
                current_frame_pts = None
                current_frame_tgt = None
                frame_idx_pts = 0
                frame_idx_tgt = 0
                frames_keys = ["f1", "f2", "f3"]
                
                for line in res.splitlines():
                    if "LOG(synthdata) 2D points for frame" in line:
                        current_frame_tgt = None
                        current_frame_pts = frames_keys[frame_idx_pts]
                        frame_idx_pts += 1
                        continue
                    if "LOG(synthdata) 2D tangents for frame" in line:
                        current_frame_pts = None
                        current_frame_tgt = frames_keys[frame_idx_tgt]
                        frame_idx_tgt += 1
                        continue

                    if current_frame_pts and ("LOG" not in line) and (line.strip() != ""):
                        parts = line.strip().split()
                        if len(parts) >= 2:
                            x, y = float(parts[0]), float(parts[1])
                            point_data[current_frame_pts].append({"x": x, "y": y})
                            
                    if current_frame_tgt and ("LOG" not in line) and (line.strip() != ""):
                        parts = line.strip().split()
                        if len(parts) >= 2:
                            tx, ty = float(parts[0]), float(parts[1])
                            tangent_data[current_frame_tgt].append({"x": tx, "y": ty})

                    if "LOG(synthdata) id" in line or "LOG(synthdata) K" in line:
                        current_frame_pts = None
                        current_frame_tgt = None

                # Zip tangents into points
                for fk in frames_keys:
                    for idx, pt in enumerate(point_data[fk]):
                        if idx < len(tangent_data[fk]):
                            pt["tx"] = tangent_data[fk][idx]["x"]
                            pt["ty"] = tangent_data[fk][idx]["y"]

            except Exception as e:
                print(f"Error fetching synthdata for {config_name}: {e}")

        plot_data.append({
            "x": config_name,
            "y": steps,
            "config": config_str,
            "points": point_data
        })

try:
    with open("all_steps.txt", "r") as af:
        steps_all = [int(line.strip()) for line in af if line.strip().isdigit()]
    if steps_all:
        steps_all.sort()
        mid = len(steps_all) // 2
        grand_median = steps_all[mid] if len(steps_all) % 2 == 1 else (steps_all[mid - 1] + steps_all[mid]) / 2.0
    else:
        grand_median = 0
except Exception:
    grand_median = 0

num_runs = 1
try:
    for script_candidate in ["../script-gammaotimo", "script-gammaotimo"]:
        if os.path.exists(script_candidate):
            with open(script_candidate, "r") as sf:
                for line in sf:
                    if "# number of runs" in line or "number of runs" in line:
                        m = re.search(r'seq\s+\d+\s+(\d+)', line)
                        if m:
                            num_runs = int(m.group(1))
                            break
            if num_runs > 1:
                break
except Exception:
    pass

# Fallback: if steps in plot_data, each run has 312 solutions
if num_runs <= 1 and plot_data and len(plot_data[0]["y"]) >= 312:
    detected_runs = len(plot_data[0]["y"]) // 312
    if detected_runs > 0:
        num_runs = detected_runs

with open("data.js", "w") as f:
    f.write(f"const benchmarkData = {json.dumps(plot_data)};\n")
    f.write(f"const grandMedian = {grand_median};\n")
    f.write(f"const numRuns = {num_runs};\n")

EOF

env SYNTHDATA_BIN="$synthdata" python3 update_data.py


cat << 'EOF' > index.html
